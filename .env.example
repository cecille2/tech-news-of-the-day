# ── Required ────────────────────────────────────────────────────────────
# Supabase (or any Postgres with the pgvector extension enabled) connection
# string. Supabase free tier includes pgvector — enable it once in the
# project's Database > Extensions page before running migrations.
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Structurally free at any scale; not a billed API. The public key must also
# be exposed to the browser (Next.js requires the NEXT_PUBLIC_ prefix for that).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="" # same value as VAPID_PUBLIC_KEY above

# V1 is single-user — this identifies "you" until real accounts exist.
OWNER_EMAIL="you@example.com"
OWNER_TIMEZONE="America/Los_Angeles"

# Protects POST /api/admin/seed, a one-time endpoint that populates the
# default source catalog — useful when you deployed without local Node
# access and can't run `npm run seed` yourself. Generate any random string
# (e.g. `openssl rand -hex 32`). Leaving this unset disables the endpoint.
SEED_TOKEN=""

# ── Optional ────────────────────────────────────────────────────────────
# YouTube Data API key, for keyword-based topic DISCOVERY only — followed
# creator channels use free per-channel RSS regardless of this being set.
# Create the key on a Google Cloud project with NO billing account attached
# (see README § accidental-charge protection) so exceeding the free daily
# quota simply errors instead of ever being billable.
YOUTUBE_API_KEY=""

# ── Optional — Layer 2/3 synthesis providers ───────────────────────────
# ALL of these are OFF by default. The pipeline runs entirely on the free,
# deterministic ExtractiveSynthesisProvider unless one of these is set.
# Setting any of them means YOU are opting into that provider's own billing —
# set a spend cap with the provider first. Set PREFERRED_SYNTHESIS_PROVIDER
# to pin one explicitly (e.g. "ANTHROPIC"); otherwise the first configured
# provider found wins, checked in this order: Ollama, Kimi, Anthropic, OpenAI, Gemini.
PREFERRED_SYNTHESIS_PROVIDER=""

OLLAMA_HOST=""
OLLAMA_MODEL="llama3.1"

MOONSHOT_API_KEY=""
MOONSHOT_MODEL="moonshot-v1-8k"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
